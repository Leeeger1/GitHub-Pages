// ============================================================================
//  牛马工作室 · 皮肤模板
// ----------------------------------------------------------------------------
//  怎么用：
//    1. 把这个文件复制到皮肤文件夹，改个名字（比如 海边.json）：
//         Windows   C:\Users\你的用户名\.niuma\skins\
//         macOS     /Users/你的用户名/.niuma/skins/
//         Linux     ~/.niuma/skins/
//       （软件里点皮肤栏的「＋ 做皮肤」→「打开文件夹」可以直接打开它）
//    2. 用记事本 / VS Code 改下面的颜色，存盘。
//    3. 回到牛马工作室的窗口，皮肤栏里就多了这一套；改了文件，切回窗口就会重新读。
//
//  规则：
//    - 以 // 开头的是说明，删掉也没关系。
//    - 颜色可以写 "#1e9bd7"、"#19d"、"rgb(30,155,215)"、"rgba(0,0,0,.2)"、"white"。
//    - 不想改的项直接删掉，会用 base 那套皮肤原来的颜色。
//    - 写错的项会被跳过，软件里「做皮肤」底部会告诉你哪里不对。
//
//  更省事的办法：软件里点「＋ 做皮肤」，点颜色、实时看效果，存好就是这样一个文件。
// ============================================================================
{
  // 皮肤的名字，显示在皮肤栏里（24 个字以内）
  "name": "海边度假",

  // 从哪套内置皮肤改起，没写的项都照它来：
  //   sakura 樱花 / night 夜班 / neon 赛博霓虹 / neko 猫耳咖啡 / pixel 像素复古（像素风只能改界面颜色）
  "base": "sakura",

  // 深色皮肤写 true（头像底色、系统控件会跟着变深）
  "dark": false,

  // 作者（可选，分享给别人时显示）
  "author": "",

  // 标题「牛马工作室」用的字体（可选，写电脑上装了的字体名，比如 "楷体"、"Comic Sans MS"）
  "font": "",

  // ---- 界面颜色：页面、面板、按钮 --------------------------------------------
  "colors": {
    "bg": "#f1f9fd",                       // 页面背景
    "panel": "#ffffff",                    // 面板：聊天、任务板、项目组卡片
    "panel2": "#e6f4fb",                   // 面板里的浅色块（对话气泡、头像底色）
    "ink": "#23405a",                      // 文字
    "muted": "#6a8aa3",                    // 次要文字
    "line": "#d3e8f3",                     // 分隔线
    "edge": "#a9d6ee",                     // 面板边框
    "drop": "rgba(30, 155, 215, 0.16)",    // 阴影（一般用强调色，调淡一点）
    "accent": "#1e9bd7",                   // 强调色：标题、按钮、选中的东西
    "onAccent": "#ffffff",                 // 强调色按钮上的字
    "ok": "#2e8b4e",                       // 成功 / 在岗
    "warn": "#a86d12",                     // 提醒
    "bad": "#c0392b"                       // 出错
  },

  // ---- 办公室画面（二次元皮肤；base 是 pixel 时这一段不起作用）--------------
  "room": {
    // 窗外风景：sakura 樱花 / city 城市夜景 / cyber 赛博城市 / garden 花园 / sea 大海 / sky 只有天空 / image 用下面 images.window 的图片
    "window": "sea",
    // 飘落效果：petals 花瓣 / snow 雪花 / stars 星光 / bubbles 泡泡 / none 不要
    "particles": "bubbles",
    // 墙上花纹：paws 猫爪 / dots 圆点 / stripes 竖条 / grid 霓虹格子 / none 没有
    "wallPattern": "dots",

    // 小彩蛋（true 开 / false 关）
    "catEars": false,   // 大家都戴猫耳
    "cat": false,       // 办公室里养一只猫（猫爬架 + 会议桌上睡觉的猫）
    "lamps": false,     // 工位上有台灯
    "neon": false,      // 霓虹灯：墙裙发光、地板透视线

    // 颜色。两个颜色的是从上到下的渐变
    "wall": ["#f5fbff", "#e2f2fb"],        // 墙
    "wainscot": "#cfe9f7",                 // 墙裙（墙下半截）
    "trim": "#8ccbe8",                     // 墙裙上的装饰线（也是圆点花纹的颜色）
    "floor": ["#f4e3c3", "#ead3a8"],       // 地板：远处、近处
    "floorLine": "#dcc08f",                // 地板缝
    "sky": ["#5cc2ff", "#a8e1ff", "#eaf7ff"], // 窗外天空：上、中、下
    "desk": "#f5e6cf",                     // 工位桌子
    "deskTop": "#fffaf0",                  // 桌面
    "deskEdge": "#d8b98f",                 // 桌子描边
    "monitor": "#f8fbff",                  // 显示器
    "monitorEdge": "#bcd6e8",              // 显示器边框和支架
    "table": "#fffaf2",                    // 中间的会议桌
    "tableEdge": "#d9bf96",                // 会议桌描边
    "rug": "#bfe6f7",                      // 会议桌下的地毯
    "frame": "#ffffff",                    // 窗框、钟
    "frameEdge": "#8ccbe8",                // 窗框描边
    "boss": "#c8ecff",                     // 傻妞的桌子
    "bossEdge": "#1e9bd7",                 // 傻妞桌子描边
    "ink": "#35566f",                      // 钟的指针
    "plant": ["#4fbf8f", "#2f9c6f"],       // 盆栽叶子：亮、暗
    "pot": "#f0a868"                       // 花盆
  },

  // ---- 图片（可选）-----------------------------------------------------------
  // 图片放在这个文件旁边，写文件名；支持 png / jpg / gif / webp，每张不超过 4MB。
  "images": {
    "wall": "",       // 墙纸，铺满墙的上半截，比如 "wall.png"
    "window": ""      // 窗外的风景，比如 "sea.jpg"（要把上面的 room.window 改成 "image"）
  }
}
